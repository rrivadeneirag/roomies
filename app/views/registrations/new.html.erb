<% content_for :title, "Sign up" %>
<div class="container py-5" style="max-width: 480px;">
  <h1 class="h3 mb-4">Create your account</h1>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path do |f| %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :email_address, "Email", class: "form-label" %>
      <%= f.email_field :email_address, class: "form-control", required: true, autocomplete: "email" %>
    </div>
    <div class="mb-3">
      <%= f.label :phone, class: "form-label" %>
      <%= f.text_field :phone, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-control", required: true, autocomplete: "new-password" %>
    </div>
    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Sign up", class: "btn btn-primary w-100" %>
  <% end %>

  <p class="mt-3 text-center">Already have an account? <%= link_to "Log in", new_session_path %></p>
</div>
