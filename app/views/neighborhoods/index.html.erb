<% content_for :title, "Neighborhoods" %>

<div class="container py-5">
  <h1 class="h3 mb-4">Neighborhoods</h1>

  <% if @neighborhoods.any? %>
    <div class="row g-4">
      <% @neighborhoods.each do |neighborhood| %>
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="h5"><%= neighborhood.name %></h2>
              <p class="text-muted mb-2"><%= neighborhood.city %></p>
              <p class="mb-2"><%= pluralize(neighborhood.properties.size, "property", plural: "properties") %></p>
              <%= link_to "View neighborhood", neighborhood_path(neighborhood), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">No neighborhoods yet.</div>
  <% end %>
</div>
