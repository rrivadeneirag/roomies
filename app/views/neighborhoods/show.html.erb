<% content_for :title, @neighborhood.name %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-2">
    <div>
      <p class="mb-1"><%= link_to "← Back to neighborhoods", neighborhoods_path, class: "text-decoration-none" %></p>
      <h1 class="h3 mb-0"><%= @neighborhood.name %></h1>
      <p class="text-muted mb-0"><%= @neighborhood.city %></p>
    </div>
    <div class="text-nowrap">
      <%= link_to "Edit", edit_neighborhood_path(@neighborhood), class: "btn btn-outline-secondary btn-sm" %>
      <%= button_to "Delete", neighborhood_path(@neighborhood), method: :delete,
            class: "btn btn-outline-danger btn-sm", form: { style: "display:inline" },
            data: { turbo_confirm: "Delete this neighborhood and its properties?" } %>
    </div>
  </div>

  <h2 class="h4 mt-4 mb-3">Available rooms here</h2>
  <% if @listings.any? %>
    <div class="row g-4">
      <%= render partial: "listings/listing_card", collection: @listings, as: :listing %>
    </div>
  <% else %>
    <p class="text-muted">No published rooms in this neighborhood right now.</p>
  <% end %>
</div>
