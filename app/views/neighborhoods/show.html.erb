<% content_for :title, @neighborhood.name %>

<div class="container py-5">
  <p><%= link_to "← Back to neighborhoods", neighborhoods_path, class: "text-decoration-none" %></p>

  <h1 class="h3"><%= @neighborhood.name %></h1>
  <p class="text-muted"><%= @neighborhood.city %></p>

  <h2 class="h4 mt-4 mb-3">Available rooms here</h2>
  <% if @listings.any? %>
    <div class="row g-4">
      <%= render partial: "listings/listing_card", collection: @listings, as: :listing %>
    </div>
  <% else %>
    <p class="text-muted">No published rooms in this neighborhood right now.</p>
  <% end %>
</div>
