<header>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom" aria-label="Main navigation">
    <div class="container">
      <%= link_to "Roomies", root_path, class: "navbar-brand fw-bold" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><%= link_to "Rooms", listings_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Search", search_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Properties", properties_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Neighborhoods", neighborhoods_path, class: "nav-link" %></li>

          <% if authenticated? %>
            <li class="nav-item"><%= link_to "Amenities", amenities_path, class: "nav-link" %></li>
            <% if current_user.moderator? %>
              <li class="nav-item">
                <%= link_to reports_path, class: "nav-link" do %>
                  Reports
                  <% if pending_reports_count.positive? %>
                    <span class="badge bg-danger"><%= pending_reports_count %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
            <li class="nav-item">
              <%= link_to applications_path, class: "nav-link" do %>
                Applications
                <% if pending_applications_count.positive? %>
                  <span class="badge bg-primary"><%= pending_applications_count %></span>
                <% end %>
              <% end %>
            </li>
            <li class="nav-item"><%= link_to current_user.name, profile_path, class: "nav-link" %></li>
            <li class="nav-item">
              <%= button_to "Log out", session_path, method: :delete, class: "btn btn-outline-secondary btn-sm ms-lg-2" %>
            </li>
          <% else %>
            <li class="nav-item"><%= link_to "Log in", new_session_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Sign up", new_registration_path, class: "btn btn-primary btn-sm ms-lg-2" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>
