<% content_for :title, "Edit profile" %>
<div class="container py-5" style="max-width: 560px;">
  <h1 class="h3 mb-4">Edit profile</h1>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :phone, class: "form-label" %>
      <%= f.text_field :phone, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :bio, "Short bio", class: "form-label" %>
      <%= f.text_area :bio, class: "form-control", rows: 3 %>
    </div>
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", profile_path, class: "btn btn-link" %>
  <% end %>
</div>
