<% content_for :title, "My profile" %>
<div class="container py-5" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My profile</h1>
    <%= link_to "Edit profile", edit_profile_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
  <ul class="list-group">
    <li class="list-group-item"><strong>Name:</strong> <%= @user.name %></li>
    <li class="list-group-item"><strong>Email:</strong> <%= @user.email_address %></li>
    <li class="list-group-item"><strong>Phone:</strong> <%= @user.phone.presence || "—" %></li>
    <li class="list-group-item"><strong>Role:</strong> <%= @user.role.titleize %></li>
    <li class="list-group-item"><strong>Bio:</strong> <%= @user.bio.presence || "—" %></li>
  </ul>
</div>
