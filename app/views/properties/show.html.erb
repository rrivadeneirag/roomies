<% content_for :title, "Property detail" %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-2">
    <div>
      <p class="mb-1"><%= link_to "← Back to properties", properties_path, class: "text-decoration-none" %></p>
      <h1 class="h3 mb-0"><%= @property.property_type %> in <%= @property.neighborhood.name %></h1>
    </div>
    <div class="text-nowrap">
      <%= link_to "Edit", edit_property_path(@property), class: "btn btn-outline-secondary btn-sm" %>
      <%= button_to "Delete", property_path(@property), method: :delete,
            class: "btn btn-outline-danger btn-sm", form: { style: "display:inline" },
            data: { turbo_confirm: "Delete this property?" } %>
    </div>
  </div>

  <p class="text-muted"><%= @property.address %></p>

  <ul class="list-inline">
    <li class="list-inline-item"><strong><%= @property.bedrooms %></strong> bedrooms</li>
    <li class="list-inline-item">·</li>
    <li class="list-inline-item"><strong><%= @property.bathrooms %></strong> bathrooms</li>
    <li class="list-inline-item">·</li>
    <li class="list-inline-item">Host: <%= @property.host.name %></li>
    <li class="list-inline-item">·</li>
    <li class="list-inline-item"><%= link_to @property.neighborhood.name, neighborhood_path(@property.neighborhood) %></li>
  </ul>

  <% if @property.shared_spaces.present? %>
    <p><strong>Shared spaces:</strong> <%= @property.shared_spaces %></p>
  <% end %>

  <h2 class="h5 mt-3">Amenities</h2>
  <% if @property.amenities.any? %>
    <% @property.amenities.each do |amenity| %>
      <span class="badge bg-light text-dark border me-1 mb-1"><%= amenity.name %></span>
    <% end %>
  <% else %>
    <p class="text-muted">None listed.</p>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h2 class="h4 mb-0">Listings in this property</h2>
    <% if current_user == @property.host %>
      <%= link_to "New listing", new_property_listing_path(@property), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @listings.any? %>
    <div class="row g-4">
      <%= render partial: "listings/listing_card", collection: @listings, as: :listing %>
    </div>
  <% else %>
    <p class="text-muted">No listings for this property yet.</p>
  <% end %>

  <% if @reviewable_visits.any? %>
    <h2 class="h4 mt-5 mb-3">Leave a review</h2>
    <p class="text-muted">You have completed visits here. Share how it went.</p>
    <% @reviewable_visits.each do |visit| %>
      <div class="card mb-3">
        <div class="card-body">
          <h3 class="h6">
            <%= visit.application.listing.property.property_type %> —
            visit on <%= visit.scheduled_at.strftime("%b %-d, %Y") %>
          </h3>
          <%= form_with model: [visit, Review.new] do |f| %>
            <div class="row g-2 align-items-end">
              <div class="col-auto">
                <%= f.label :rating, class: "form-label" %>
                <%= f.select :rating, (1..5).to_a, { prompt: "1–5" }, class: "form-select" %>
              </div>
              <div class="col-12">
                <%= f.label :comment, class: "form-label" %>
                <%= f.text_area :comment, class: "form-control", rows: 2 %>
              </div>
              <div class="col-12">
                <div class="form-check">
                  <%= f.check_box :matched, class: "form-check-input", checked: true %>
                  <%= f.label :matched, "I moved in", class: "form-check-label" %>
                </div>
              </div>
              <div class="col-12">
                <%= f.submit "Post review", class: "btn btn-primary btn-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <h2 class="h4 mt-5 mb-3">Reviews</h2>
  <%= render "shared/reviews", reviews: @reviews %>
</div>
