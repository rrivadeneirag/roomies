<%= form_with model: amenity do |f| %>
  <% if amenity.errors.any? %>
    <div class="alert alert-danger">Please fix the errors below.</div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g. WiFi" %>
    <%= render "shared/field_error", resource: amenity, attribute: :name %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", amenities_path, class: "btn btn-link" %>
<% end %>
