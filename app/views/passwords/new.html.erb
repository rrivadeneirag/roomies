<% content_for :title, "Reset password" %>
<div class="container py-5" style="max-width: 420px;">
  <h1 class="h3 mb-4">Reset your password</h1>
  <%= form_with url: passwords_path do %>
    <div class="mb-3">
      <%= label_tag :email_address, "Email", class: "form-label" %>
      <%= email_field_tag :email_address, nil, class: "form-control",
            required: true, autocomplete: "email" %>
    </div>
    <%= submit_tag "Email reset instructions", class: "btn btn-primary w-100" %>
  <% end %>
  <p class="mt-3"><%= link_to "Back to log in", new_session_path %></p>
</div>
