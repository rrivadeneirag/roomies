<% content_for :title, "Log in" %>
<div class="container py-5" style="max-width: 420px;">
  <h1 class="h3 mb-4">Log in</h1>
  <%= form_with url: session_path do %>
    <div class="mb-3">
      <%= label_tag :email_address, "Email", class: "form-label" %>
      <%= email_field_tag :email_address, params[:email_address], class: "form-control",
            required: true, autocomplete: "email", autofocus: true %>
    </div>
    <div class="mb-3">
      <%= label_tag :password, "Password", class: "form-label" %>
      <%= password_field_tag :password, nil, class: "form-control",
            required: true, autocomplete: "current-password" %>
    </div>
    <%= submit_tag "Log in", class: "btn btn-primary w-100" %>
  <% end %>
  <p class="mt-3 d-flex justify-content-between">
    <%= link_to "Forgot password?", new_password_path %>
    <%= link_to "Sign up", new_registration_path %>
  </p>
</div>
