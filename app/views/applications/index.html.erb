<% content_for :title, "Applications" %>

<div class="container py-5">
  <h1 class="h3 mb-2">Applications</h1>
  <p class="text-muted mb-4"><%= @pending %> pending an answer</p>

  <% if @applications.any? %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th scope="col">Seeker</th>
            <th scope="col">Room</th>
            <th scope="col">Move-in</th>
            <th scope="col">Stay</th>
            <th scope="col">Status</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% @applications.each do |application| %>
            <tr>
              <td><%= application.seeker.name %></td>
              <td><%= application.listing.property.property_type %> in
                  <%= application.listing.property.neighborhood.name %></td>
              <td><%= application.move_in_on.strftime("%b %-d, %Y") %></td>
              <td><%= pluralize(application.stay_months, "month") %></td>
              <td><span class="badge bg-secondary"><%= application.status %></span></td>
              <td class="text-end"><%= link_to "View", application_path(application), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">No applications yet.</div>
  <% end %>
</div>
