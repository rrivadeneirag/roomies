# Secrets para Kamal. Este archivo es seguro para git: NO contiene credenciales,
# solo lee de variables de entorno / archivos locales.

# Master key de Rails (desde config/master.key, que NO va a git).
RAILS_MASTER_KEY=$(cat config/master.key)

# Token de acceso de Docker Hub (lo exportas en tu terminal antes de desplegar).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Contraseña de la base de datos (la eliges tú; la exportas antes de desplegar).
# El contenedor de Postgres y la app usan la MISMA contraseña.
ROOMIES_DATABASE_PASSWORD=$ROOMIES_DATABASE_PASSWORD
POSTGRES_PASSWORD=$ROOMIES_DATABASE_PASSWORD
